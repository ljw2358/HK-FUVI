                <p>Profit Share: <span class="status-val">30% UBI Applied</span></p>
                <button class="btn-action" onclick="alert('Activating Customer Success Program...')">JOIN SUCCESS PROGRAM</button>
            </div>

            <!-- 3. Pi Network 및 자동 스테이킹 -->
            <div class="card">
