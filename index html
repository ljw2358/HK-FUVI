                <p>Yield Rate: <span class="status-val">31.41% APY</span></p>
                <button class="btn-action" onclick="alert('Staking protocol initiated.')">ENABLE STAKING</button>
            </div>
        </div>

        <footer>
            &copy; 2026 HK GROUP. CHAIRMAN HYEKONG. ALL RIGHTS RESERVED.
        </footer>
