<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HK-FUVI & HK WorldBank | Sovereign Customer Success Platform</title>
    <style>
        :root {
            --main-gold: #D4AF37;
            --success-green: #2ecc71;
            --bg-dark: #030712;
            --card-bg: rgba(15, 23, 42, 0.85);
            --border-color: rgba(212, 175, 55, 0.3);
            --text-main: #f3f4f6;
            --text-sub: #94a3b8;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Noto Sans KR', 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            width: 200vw;
            height: 200vh;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.05) 0%, rgba(3, 7, 18, 1) 70%);
            z-index: -1;
        }

        .container {
            width: 100%;
            max-width: 1200px;
        }

        header {
            text-align: center;
            margin-bottom: 40px;
        }

        .badge {
            display: inline-block;
            font-size: 0.8rem;
            letter-spacing: 3px;
            color: var(--main-gold);
            border: 1px solid var(--border-color);
            padding: 6px 16px;
            border-radius: 20px;
            margin-bottom: 15px;
            background: rgba(212, 175, 55, 0.05);
            text-transform: uppercase;
        }

        h1 {
            font-size: 2.8rem;
            font-weight: 900;
            color: #ffffff;
            margin-bottom: 10px;
            letter-spacing: 2px;
            text-shadow: 0 0 20px rgba(212, 175, 55, 0.2);
        }

        p.subtitle {
            font-size: 1.1rem;
            color: var(--text-sub);
            font-weight: 300;
            margin-bottom: 25px;
        }

        .lang-box {
            margin-bottom: 30px;
        }

        select#langSelect {
            background: rgba(15, 23, 42, 0.9);
            color: var(--main-gold);
            border: 1px solid var(--border-color);
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 1rem;
            cursor: pointer;
            outline: none;
            transition: all 0.3s ease;
        }

        select#langSelect:hover {
            border-color: var(--main-gold);
            background: rgba(30, 41, 59, 1);
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 30px 25px;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--main-gold);
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: var(--main-gold);
            box-shadow: 0 10px 30px -10px rgba(212, 175, 55, 0.3);
        }

        .card h3 {
            color: var(--main-gold);
            margin-bottom: 15px;
            font-size: 1.3rem;
        }

        .card p {
            font-size: 0.95rem;
            color: #cbd5e1;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .status-val {
            color: var(--success-green);
            font-weight: bold;
        }

        .btn-action {
            background: var(--main-gold);
            color: #000;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: opacity 0.3s ease;
            margin-top: 10px;
        }

        .btn-action:hover {
            opacity: 0.85;
        }

        footer {
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-sub);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 25px;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
